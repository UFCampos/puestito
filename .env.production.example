# ─────────────────────────────────────────────────────────────
# TuPuestito — variables de producción (docker-compose.prod.yml)
# Copiá a .env.production y completá. NUNCA lo subas a git.
# ─────────────────────────────────────────────────────────────

# Dominios (Caddy emite los certificados HTTPS)
WEB_DOMAIN=tupuestito.com.ar
API_DOMAIN=api.tupuestito.com.ar
ACME_EMAIL=admin@tupuestito.com.ar
WEB_URL=https://tupuestito.com.ar
API_URL=https://api.tupuestito.com.ar
# Comparte la cookie de sesión entre tupuestito.com.ar y api.tupuestito.com.ar
COOKIE_DOMAIN=tupuestito.com.ar

# PostgreSQL 16
POSTGRES_USER=tupuestito
POSTGRES_PASSWORD=          # openssl rand -base64 32
POSTGRES_DB=tupuestito

# Better Auth — openssl rand -base64 48
BETTER_AUTH_SECRET=
REQUIRE_EMAIL_VERIFICATION=true
# OAuth (redirect URIs: https://api.tupuestito.com.ar/api/auth/callback/google | /discord)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Botones que muestra el frontend (solo los que configuraste arriba)
NEXT_PUBLIC_SOCIAL_PROVIDERS=google,discord

# Cifrado AES-256-GCM de tokens de Mercado Pago — openssl rand -base64 32
# ⚠️ Si la perdés o la cambiás, los artistas tienen que volver a vincular MP.
ENCRYPTION_KEY=

# Cloudflare R2
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=tupuestito-public
R2_PRIVATE_BUCKET=tupuestito-private
R2_PUBLIC_URL=https://cdn.tupuestito.com.ar

# Mercado Pago Marketplace (app de tipo "Marketplace" en developers.mercadopago.com)
# Redirect URI de OAuth: https://api.tupuestito.com.ar/api/payments/mp/callback
# Webhook (evento "Pagos"): https://api.tupuestito.com.ar/api/payments/webhook
PAYMENTS_MODE=live
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=5

# Notificaciones
RESEND_API_KEY=
EMAIL_FROM=TuPuestito <no-reply@tupuestito.com.ar>
DISCORD_WEBHOOK_URL=

# ── Reglas de los pedidos (días salvo que se indique) ──
DEPOSIT_EXPIRATION_HOURS=72
REQUEST_EXPIRATION_DAYS=7        # solicitud que el artista no responde
REVIEW_AUTO_APPROVE_DAYS=7       # entrega que el comprador no revisa → se aprueba sola
PAYMENT_TIMEOUT_DAYS=14          # pago intermedio pendiente → el artista puede cerrar el pedido
OVERDUE_ESCALATION_DAYS=7        # atraso del artista que se avisa a moderación
POST_DELIVERY_DISPUTE_DAYS=7     # ventana para reclamar después de la entrega final
ORDER_FILES_RETENTION_DAYS=30    # archivos de pedidos cerrados sin completar
JOBS_INTERVAL_MINUTES=10         # frecuencia de los plazos automáticos

# ── Soporte y moderación ──
SUPPORT_EMAIL=soporte@tupuestito.com.ar   # casilla atendida: consultas y botón de arrepentimiento
ADMIN_EMAILS=                             # emails del equipo (separados por coma); pasan a ADMIN con el email verificado

# ── Datos del titular (aparecen en el pie y en los textos legales) ──
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_CUIT=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_DATA_FISCAL_URL=     # link del formulario 960/D "Data Fiscal" de ARCA
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=    # opcional: analítica sin cookies

# ── Backups de PostgreSQL ──
BACKUP_S3_BUCKET=tupuestito-backups   # bucket R2 privado y dedicado; vacío = solo backups locales
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24

# Límites de subida (MB por archivo). Las referencias del comprador están fijas en 5 MB.
MAX_AVATAR_MB=8
MAX_PORTFOLIO_MB=25
MAX_SKETCH_MB=30
# Entrega final (imagen, .zip, .rar o .psd). Si lo subís, ajustá también
# `request_body { max_size }` en deploy/Caddyfile (hoy 210MB).
MAX_FINAL_DELIVERY_MB=200
