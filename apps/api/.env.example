# Desarrollo local — copiá a apps/api/.env
DATABASE_URL=postgresql://tupuestito:tupuestito_dev_password@localhost:5432/tupuestito
# Con pnpm db:embedded (PGlite) usar 1; con Docker o PostgreSQL real podés usar 10
DATABASE_POOL_MAX=1
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Sin R2: los archivos se guardan en ./storage (privados con URLs firmadas)
STORAGE_DRIVER=local

# mock = simulador de checkout local (solo dev). live = API real de Mercado Pago
# (con credenciales de prueba de MP funciona como sandbox)
PAYMENTS_MODE=mock
# MP_CLIENT_ID=
# MP_CLIENT_SECRET=
# MP_WEBHOOK_SECRET=

# Opcionales en dev (sin Resend, los emails se imprimen en consola)
# RESEND_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Equipo de moderación y soporte
# ADMIN_EMAILS=tu@email.com
# SUPPORT_EMAIL=soporte@tupuestito.com.ar
# Plazos automáticos (ver .env.production.example). JOBS_INTERVAL_MINUTES=0 los apaga.

# Límites de subida en MB (opcionales; estos son los valores por defecto)
# MAX_AVATAR_MB=8
# MAX_PORTFOLIO_MB=25
# MAX_SKETCH_MB=30
# MAX_FINAL_DELIVERY_MB=200
