# Plan §1: Caddy como reverse proxy con HTTPS automático.
# Si usás Cloudflare en modo proxy, configurá SSL/TLS = "Full (strict)".
{
	email {$ACME_EMAIL}
}

(logs) {
	log {
		output stdout
		format console
	}
}

{$WEB_DOMAIN} {
	import logs
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy web:3000
}

www.{$WEB_DOMAIN} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}

{$API_DOMAIN} {
	import logs
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# Entregas finales de hasta 200 MB
	request_body {
		max_size 210MB
	}
	reverse_proxy api:4000
}
